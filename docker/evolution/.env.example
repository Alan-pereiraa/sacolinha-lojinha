# Chave global da API — use a mesma em EVOLUTION_API_KEY do Next.js
AUTHENTICATION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
SERVER_URL=http://localhost:8080

POSTGRES_PASSWORD=troque-esta-senha
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:troque-esta-senha@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=sacolinha
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

CONFIG_SESSION_PHONE_CLIENT=Sacolinha
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
LANGUAGE=pt-BR
DEL_INSTANCE=false
